{
  "name": "gptr",
  "version": "1.3.1",
  "description": "Work inside an R session you already have open. The agent inspects, analyses, plots and fixes the objects in memory through gptr, without reloading data. Every call passes gptr's permission settings. Needs R with the gptr package and uv.",
  "author": {"name": "Wanjun Gu"},
  "homepage": "https://broccolito.github.io/gptr/",
  "repository": "https://github.com/Broccolito/gptr",
  "license": "Apache-2.0",
  "keywords": ["r", "gptr", "mcp", "live-session"],
  "mcpServers": {
    "gptr": {
      "command": "uv",
      "args": ["run", "--no-project", "--python", ">=3.11", "python", "-m", "gptr_mcp_bridge"],
      "cwd": "./src",
      "env_vars": ["GPTR_MCP_DISCOVERY_DIR", "GPTR_RSCRIPT", "GPTRAGENT_RSCRIPT", "R_USER_CACHE_DIR", "XDG_CACHE_HOME"],
      "startup_timeout_sec": 60,
      "tool_timeout_sec": 300
    }
  }
}
