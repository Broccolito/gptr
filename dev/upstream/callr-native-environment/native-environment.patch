+# Complete processx environment, prepared without changing the caller.
+# NA removes a name; an empty string remains a real empty child entry.
+native_child_env = function(env, parent = Sys.getenv(),
+  windows = identical(.Platform$OS.type, "windows")) {
+  stopifnot(is.character(env), length(env) == 0L || is.named(env))
+  key = if (windows) toupper else identity
+  env = env[!duplicated(key(names(env)), fromLast = TRUE)]
+  parent = parent[!(key(names(parent)) %in% key(names(env)))]
+  out = c(parent, env[!is.na(env)])
+  out[!duplicated(key(names(out)), fromLast = TRUE)]
+}
+
+# Keep an explicitly supplied processx environment and its "current" sentinel.
+native_child_args = function(env, extra, parent = Sys.getenv(),
+  windows = identical(.Platform$OS.type, "windows")) {
+  child = native_child_env(env, parent = parent, windows = windows)
+  if (!is.null(extra$env)) {
+    pxenv = extra$env
+    if (is.null(names(pxenv))) names(pxenv) = rep("", length(pxenv))
+    current = !is.na(pxenv) & pxenv == "current" & names(pxenv) == ""
+    if (any(current)) {
+      pxenv = pxenv[!current]
+      child = c(child[!(names(child) %in% names(pxenv))], pxenv)
+    } else {
+      child = extra$env
+    }
+  }
+  extra$env = child
+  extra
+}
