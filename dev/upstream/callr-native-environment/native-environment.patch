+++ b/tests/testthat/test-native-child-env.R
@@ -0,0 +1,199 @@
+test_that("native child environment preserves empty values and explicit removals", {
+  parent = c(KEEP = "", REMOVE = "old", CHANGE = "old", UNTOUCHED = "value")
+  env = c(REMOVE = NA_character_, CHANGE = "", ADD = "new")
+  before = parent
+  expect_identical(
+    native_child_env(env, parent = parent, windows = FALSE),
+    c(KEEP = "", UNTOUCHED = "value", CHANGE = "", ADD = "new")
+  )
+  expect_identical(parent, before)
+})
+
+test_that("native child environment follows platform name matching", {
+  parent = c(Path = "old", Keep = "", DROP = "old")
+  env = c(PATH = "first", path = "last", drop = NA_character_)
+  expect_identical(
+    native_child_env(env, parent = parent, windows = TRUE),
+    c(Keep = "", path = "last")
+  )
+  expect_identical(
+    native_child_env(env, parent = parent, windows = FALSE),
+    c(parent, PATH = "first", path = "last")
+  )
+})
+
+test_that("native child environment retains final prepared startup and trace values", {
+  parent = c(RETAINED = "", TRACEPARENT = "old", REMOVED = "old")
+  env = c(R_PROFILE_USER = "owned-profile", CALLR_IS_RUNNING = "true",
+    TRACEPARENT = "fixed-synthetic-trace", REMOVED = NA_character_)
+  expect_identical(
+    native_child_env(env, parent = parent, windows = FALSE),
+    c(RETAINED = "", R_PROFILE_USER = "owned-profile", CALLR_IS_RUNNING = "true",
+      TRACEPARENT = "fixed-synthetic-trace")
+  )
+})
+
+test_that("native child arguments preserve processx extra env semantics", {
+  prepared = c(CALLR_IS_RUNNING = "true", CHANGE = "prepared", DROP = NA_character_)
+  parent = c(RETAINED = "", DROP = "old")
+  extra = list(env = c("current", CHANGE = "extra"), cleanup_tree = TRUE)
+  before = extra
+  expect_identical(
+    native_child_args(prepared, extra, parent = parent, windows = FALSE),
+    list(env = c(RETAINED = "", CALLR_IS_RUNNING = "true", CHANGE = "extra"),
+      cleanup_tree = TRUE)
+  )
+  expect_identical(extra, before)
+  expect_identical(
+    native_child_args(prepared, list(env = c(ONLY = "")),
+      parent = parent, windows = FALSE),
+    list(env = c(ONLY = ""))
+  )
+  expect_identical(
+    native_child_args(prepared, list(env = NULL), parent = parent, windows = FALSE),
+    list(env = c(RETAINED = "", CALLR_IS_RUNNING = "true", CHANGE = "prepared"))
+  )
+  # A complete processx env does not use callr's NA-as-removal convention.
+  # Retain it unchanged so the existing processx validation still rejects it.
+  expect_identical(
+    native_child_args(prepared, list(env = c(INVALID = NA_character_)),
+      parent = parent, windows = FALSE),
+    list(env = c(INVALID = NA_character_))
+  )
+})
+
+test_that("r_process launches without temporary parent environment mutation", {
+  local_mocked_bindings(with_envvar = function(...) {
+    stop("A background launch must use only its native child environment.")
+  })
+  before = Sys.getenv()
+  p = NULL
+  withr::defer({
+    if (!is.null(p)) {
+      if (p$is_alive()) p$kill_tree()
+      p$cleanup()
+    }
+  })
+  p = r_bg(function() {
+    list(value = 42L, marker = Sys.getenv("CALLR_NATIVE_ENV_TEST"),
+      running = Sys.getenv("CALLR_IS_RUNNING"))
+  }, env = c(CALLR_NATIVE_ENV_TEST = "synthetic-value"),
+  user_profile = FALSE, system_profile = FALSE, supervise = FALSE,
+  cleanup = TRUE, cleanup_tree = TRUE)
+  expect_true(identical(Sys.getenv(), before))
+  expect_s3_class(p, "r_process")
+  p$wait(10000L)
+  expect_false(p$is_alive())
+  expect_identical(p$get_exit_status(), 0L)
+  expect_identical(p$get_result(),
+    list(value = 42L, marker = "synthetic-value", running = "true"))
+  p$cleanup()
+  expect_true(identical(Sys.getenv(), before))
+})
+
